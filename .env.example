# Dayline — local defaults (never commit real secrets)
APP_HOST=0.0.0.0
APP_PORT=8001
ENVIRONMENT=development

# Production (Render / Railway / Cloud Run) — set in the host dashboard:
# PORT is injected by the platform — do not hardcode
# ENVIRONMENT=production
# DATABASE_URL=sqlite:////tmp/dayline.db
# JWT_SECRET=replace-with-long-random-string
# CORS_ORIGINS=https://dayline-app.web.app,https://dayline-app.firebaseapp.com,https://your-app.expo.dev

DEFAULT_REGION=toshkent
TIMEZONE=Asia/Tashkent
NAMOZVAQTI_BASE_URL=https://namozvaqti.uz
